 "doctype": "Print Format",
 "font_size": 14,
 "html": "<!DOCTYPE html>\n<html>\n<head>\n<meta charset=\"utf-8\">\n<style>\n    body {\n        font-family: -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, Helvetica, Arial, sans-serif;\n        color: #1e293b;\n        margin: 0;\n        padding: 24px;\n        background: #ffffff;\n    }\n    .header-table {\n        width: 100%;\n        border-collapse: collapse;\n        margin-bottom: 20px;\n    }\n    .header-orange-bar {\n        height: 4px;\n        background: linear-gradient(90deg, #ea580c, #f97316);\n        margin-bottom: 24px;\n        border-radius: 2px;\n    }\n    .tag-title {\n        font-size: 11px;\n        font-weight: 800;\n        letter-spacing: 0.15em;\n        text-transform: uppercase;\n        color: #ea580c;\n        margin-bottom: 4px;\n    }\n    .brand-name {\n        font-size: 26px;\n        font-weight: 800;\n        color: #0f172a;\n        margin: 0 0 4px 0;\n    }\n    .brand-sub {\n        font-size: 12px;\n        color: #64748b;\n        max-width: 380px;\n        line-height: 1.4;\n    }\n    .meta-box-row {\n        display: flex;\n        gap: 16px;\n        margin-bottom: 24px;\n    }\n    .meta-box {\n        flex: 1;\n        border: 1.5px solid #fef08a;\n        background: #fefce8;\n        border-radius: 8px;\n        padding: 12px 16px;\n    }\n    .meta-box-label {\n        font-size: 10px;\n        font-weight: 700;\n        letter-spacing: 0.1em;\n        text-transform: uppercase;\n        color: #854d0e;\n        margin-bottom: 4px;\n    }\n    .meta-box-value {\n        font-size: 14px;\n        font-weight: 700;\n        color: #1e293b;\n    }\n    .section-title {\n        font-size: 16px;\n        font-weight: 800;\n        color: #0f172a;\n        margin: 0 0 12px 0;\n    }\n    .event-details-card {\n        background: #f8fafc;\n        border: 1px solid #e2e8f0;\n        border-radius: 10px;\n        padding: 16px;\n        margin-bottom: 28px;\n    }\n    .event-details-table {\n        width: 100%;\n        border-collapse: collapse;\n    }\n    .event-details-table td {\n        padding: 8px 12px;\n        vertical-align: top;\n    }\n    .event-field-label {\n        font-size: 10px;\n        font-weight: 700;\n        letter-spacing: 0.1em;\n        text-transform: uppercase;\n        color: #64748b;\n        margin-bottom: 4px;\n    }\n    .event-field-value {\n        font-size: 13px;\n        font-weight: 700;\n        color: #0f172a;\n    }\n    .items-table {\n        width: 100%;\n        border-collapse: collapse;\n        margin-bottom: 28px;\n    }\n    .items-table th {\n        background: #0f172a;\n        color: #ffffff;\n        font-size: 11px;\n        font-weight: 700;\n        letter-spacing: 0.08em;\n        text-transform: uppercase;\n        padding: 10px 12px;\n        text-align: left;\n    }\n    .items-table td {\n        padding: 12px;\n        font-size: 12px;\n        border-bottom: 1px solid #f1f5f9;\n        vertical-align: middle;\n    }\n    .items-table tr:nth-child(even) td {\n        background: #f8fafc;\n    }\n    .badge-mode {\n        display: inline-block;\n        font-size: 10px;\n        font-weight: 700;\n        padding: 3px 8px;\n        border-radius: 4px;\n    }\n    .badge-direct {\n        background: #dbeafe;\n        color: #1d4ed8;\n        border: 1px solid #bfdbfe;\n    }\n    .badge-cash {\n        background: #fef3c7;\n        color: #b45309;\n        border: 1px solid #fde68a;\n    }\n    .summary-card {\n        background: #f8fafc;\n        border: 1px solid #e2e8f0;\n        border-radius: 10px;\n        padding: 16px 20px;\n        width: 320px;\n        margin-left: auto;\n        margin-bottom: 36px;\n    }\n    .summary-row {\n        display: flex;\n        justify-content: space-between;\n        font-size: 12px;\n        color: #475569;\n        padding: 6px 0;\n    }\n    .summary-row.total {\n        border-top: 2px solid #cbd5e1;\n        margin-top: 8px;\n        padding-top: 10px;\n        font-size: 16px;\n        font-weight: 800;\n        color: #b91c1c;\n    }\n    .approval-trail-section {\n        border-top: 1px solid #e2e8f0;\n        padding-top: 24px;\n        margin-top: 24px;\n    }\n    .approval-grid {\n        display: flex;\n        justify-content: space-between;\n        margin-top: 36px;\n    }\n    .approval-box {\n        text-align: center;\n        width: 28%;\n        border-top: 1.5px solid #cbd5e1;\n        padding-top: 8px;\n        font-size: 12px;\n    }\n    .approval-role {\n        color: #64748b;\n        font-size: 11px;\n    }\n    .approval-name {\n        font-weight: 700;\n        color: #0f172a;\n        margin-top: 2px;\n    }\n</style>\n</head>\n<body>\n\n<!-- Dynamic Letterhead or Fallback Header -->\n{% set letter_head_content = frappe.db.get_value(\"Letter Head\", doc.letter_head or (doc.company and frappe.db.get_value(\"Company\", doc.company, \"default_letter_head\")), \"content\") %}\n{% if letter_head_content %}\n    <div style=\"margin-bottom: 16px;\">\n        {{ letter_head_content }}\n    </div>\n{% else %}\n    <table class=\"header-table\">\n        <tr>\n            <td style=\"vertical-align: top;\">\n                <div class=\"tag-title\">EXPENSE CLAIMS / IMPREST PROPOSAL</div>\n                <h1 class=\"brand-name\">{{ doc.company or \"Corona Creative Solutions\" }}</h1>\n                <div class=\"brand-sub\">Automated financial proposal, approval routing, and accounting handoff for event spends.</div>\n            </td>\n            <td style=\"text-align: right; vertical-align: top;\">\n                <div style=\"font-size: 11px; color: #64748b;\">Generated On</div>\n                <div style=\"font-size: 12px; font-weight: 700; color: #0f172a; margin-bottom: 6px;\">\n                    {{ frappe.utils.format_datetime(frappe.utils.now_datetime(), \"dd/MM/yyyy, hh:mm:ss a\") }}\n                </div>\n                <div style=\"font-size: 11px; color: #64748b;\">Proposal Ref</div>\n                <div style=\"font-size: 13px; font-weight: 800; color: #ea580c;\">{{ doc.name }}</div>\n            </td>\n        </tr>\n    </table>\n{% endif %}\n\n<div class=\"header-orange-bar\"></div>\n\n<!-- Metadata Badges -->\n<table style=\"width: 100%; border-collapse: collapse; margin-bottom: 24px;\">\n    <tr>\n        <td style=\"width: 32%; padding-right: 8px;\">\n            <div class=\"meta-box\">\n                <div class=\"meta-box-label\">PREPARED BY</div>\n                <div class=\"meta-box-value\">{{ doc.spoc_name or doc.spoc or \"Event SPOC\" }}</div>\n            </div>\n        </td>\n        <td style=\"width: 32%; padding: 0 4px;\">\n            <div class=\"meta-box\">\n                <div class=\"meta-box-label\">SANCTIONED BY (BUSINESS HEAD)</div>\n                <div class=\"meta-box-value\">{{ doc.approved_by_business_head or \"Pending Approval\" }}</div>\n            </div>\n        </td>\n        <td style=\"width: 32%; padding-left: 8px;\">\n            <div class=\"meta-box\">\n                <div class=\"meta-box-label\">ACCOUNTING COPY</div>\n                <div class=\"meta-box-value\">Accounts L1 & Accounts Director (Auto CC)</div>\n            </div>\n        </td>\n    </tr>\n</table>\n\n<!-- Event Details Card -->\n<div class=\"section-title\">Event Details</div>\n<div class=\"event-details-card\">\n    {% set event_doc = frappe.get_doc(\"Event Master\", doc.event) if doc.event else None %}\n    <table class=\"event-details-table\">\n        <tr>\n            <td style=\"width: 50%;\">\n                <div class=\"event-field-label\">EVENT NAME</div>\n                <div class=\"event-field-value\">{{ event_doc.event_name if event_doc else doc.event }}</div>\n            </td>\n            <td style=\"width: 50%;\">\n                <div class=\"event-field-label\">EVENT DATE</div>\n                <div class=\"event-field-value\">{{ frappe.utils.formatdate(doc.event_date or (event_doc.start_date if event_doc else doc.creation)) }}</div>\n            </td>\n        </tr>\n        <tr>\n            <td>\n                <div class=\"event-field-label\">VENUE</div>\n                <div class=\"event-field-value\">{{ doc.venue or (event_doc.event_location if event_doc else \"Bhavan's Pottipati Ganamba Obul Reddy Auditorium\") }}</div>\n            </td>\n            <td>\n                <div class=\"event-field-label\">CONTACT PHONE</div>\n                <div class=\"event-field-value\">{{ doc.contact_phone or \"9791212413\" }}</div>\n            </td>\n        </tr>\n    </table>\n</div>\n\n<!-- Expense Details Table -->\n<div class=\"section-title\">Expense Details</div>\n<table class=\"items-table\">\n    <thead>\n        <tr>\n            <th style=\"width: 5%;\">S.NO</th>\n            <th style=\"width: 28%;\">PARTICULARS</th>\n            <th style=\"width: 18%;\">PAYMENT MODE</th>\n            <th style=\"width: 25%;\">BENEFICIARY / BANK DETAILS</th>\n            <th style=\"width: 14%; text-align: right;\">EXPENSES</th>\n            <th style=\"width: 10%;\">REMARKS</th>\n        </tr>\n    </thead>\n    <tbody>\n        {% for row in doc.imprest_items %}\n        <tr>\n            <td style=\"font-weight: 700; color: #64748b;\">{{ loop.index }}</td>\n            <td style=\"font-weight: 700; color: #0f172a;\">{{ row.particulars }}</td>\n            <td>\n                {% if row.payment_mode == 'Direct Vendor Payment' %}\n                    <span class=\"badge-mode badge-direct\">Direct Vendor</span>\n                {% else %}\n                    <span class=\"badge-mode badge-cash\">Cash Imprest</span>\n                {% endif %}\n            </td>\n            <td>\n                <div style=\"font-weight: 700; color: #1e293b;\">{{ row.beneficiary_name or \"-\" }}</div>\n                {% if row.bank_account_number %}\n                    <div style=\"font-size: 11px; color: #64748b;\">A/C: {{ row.bank_account_number }} | IFSC: {{ row.bank_ifsc_code or \"-\" }}</div>\n                    {% if row.bank_name %}<div style=\"font-size: 10px; color: #94a3b8;\">{{ row.bank_name }}</div>{% endif %}\n                {% endif %}\n            </td>\n            <td style=\"text-align: right; font-weight: 800; color: #b91c1c;\">\n                \u20b9 {{ frappe.utils.fmt_money(row.amount, precision=2) }}\n            </td>\n            <td style=\"color: #64748b; font-size: 11px;\">{{ row.remarks or \"-\" }}</td>\n        </tr>\n        {% endfor %}\n    </tbody>\n</table>\n\n<!-- Financial Summary Box -->\n<div class=\"summary-card\">\n    <div style=\"font-size: 13px; font-weight: 800; color: #0f172a; margin-bottom: 8px; border-bottom: 1px solid #e2e8f0; padding-bottom: 4px;\">\n        Summary\n    </div>\n    <div class=\"summary-row\">\n        <span>Direct Vendor Payments:</span>\n        <span style=\"font-weight: 700;\">\u20b9 {{ frappe.utils.fmt_money(doc.total_direct_vendor_amount or 0, precision=2) }}</span>\n    </div>\n    <div class=\"summary-row\">\n        <span>On-Ground Cash Imprest:</span>\n        <span style=\"font-weight: 700;\">\u20b9 {{ frappe.utils.fmt_money(doc.total_cash_imprest_amount or 0, precision=2) }}</span>\n    </div>\n    <div class=\"summary-row total\">\n        <span>Grand Total:</span>\n        <span>\u20b9 {{ frappe.utils.fmt_money(doc.requested_advance_amount or 0, precision=2) }}</span>\n    </div>\n    <div style=\"font-size: 11px; color: #64748b; margin-top: 10px; line-height: 1.4;\">\n        Prepared by {{ doc.spoc_name or doc.spoc }}, routed to Business Head for approval, and CCed to Accounts automatically.\n    </div>\n</div>\n\n<!-- Approval Trail Signatures -->\n<div class=\"approval-trail-section\">\n    <div class=\"section-title\">Approval Trail</div>\n    <div class=\"approval-grid\">\n        <div class=\"approval-box\">\n            <div class=\"approval-role\">Prepared by</div>\n            <div class=\"approval-name\">{{ doc.spoc_name or doc.spoc or \"Event SPOC\" }}</div>\n        </div>\n        <div class=\"approval-box\">\n            <div class=\"approval-role\">Approved by (Business Head)</div>\n            <div class=\"approval-name\">{{ doc.approved_by_business_head or \"Pending Approval\" }}</div>\n        </div>\n        <div class=\"approval-box\">\n            <div class=\"approval-role\">CC to</div>\n            <div class=\"approval-name\">Accounting Team</div>\n        </div>\n    </div>\n</div>\n\n<div style=\"font-size: 10px; color: #94a3b8; text-align: center; margin-top: 40px; border-top: 1px dashed #cbd5e1; padding-top: 12px;\">\n    This is an enterprise system-generated event imprest & expense proposal. All vendor bills and vouchers must be submitted for final post-event delta settlement.\n</div>\n\n</body>\n</html>\n",
